// Schema per CLAUDE.md §6. The only addition is LawyerProfile.online,
// which PLAN.md §6 explicitly allows so the LIVE strip and online dots
// have real data behind them.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Neon pooled for the app, direct for migrations (LAUNCH.md Task 3).
  directUrl = env("DIRECT_URL")
}

enum Role {
  CLIENT
  LAWYER
  ADMIN
}

enum Tier {
  LOWER
  MIDDLE
  HIGH
}

enum Status {
  PENDING
  VERIFIED
  REJECTED
}

// Paid placement tiers (LAUNCH.md Task 5). BASIC/FEATURED/SPOTLIGHT are the
// monthly rate card. PLACEMENT is the founding launch offer — one payment of
// ₹2,999 covering three years at the top of the advocate's practice area.
enum PromoTier {
  NONE
  BASIC
  FEATURED
  SPOTLIGHT
  PLACEMENT
}

// Suggestion box. SUGGESTION is the default because that is what we are
// asking for; the other two exist so a complaint does not have to masquerade
// as an idea.
enum FeedbackKind {
  SUGGESTION
  ISSUE
  PRAISE
}

// LawNest Rewards — 5% back on every paid consultation, 100 points = ₹100 off.
enum RewardKind {
  EARN
  REDEEM
}

model User {
  id     String  @id @default(cuid())
  name   String
  // Optional: Clerk accounts sign up with an email, never a phone, and we
  // never collect a government ID (LAUNCH.md ground rules).
  phone  String? @unique
  avatar String
  role   Role    @default(CLIENT)

  clerkId    String? @unique // null for the seeded catalog advocates
  email      String? @unique
  clientCode String? @unique // "LB-2026-00042", generated on client signup

  createdAt DateTime @default(now())

  // Rewards balance — kept in step with RewardLedger inside one transaction.
  points Int @default(0)

  lawyer   LawyerProfile?
  bookings Booking[]
  rewards  RewardLedger[]
}

model Category {
  id      String          @id @default(cuid())
  slug    String          @unique
  name    String
  icon    String // lucide icon name
  blurb   String // one sentence, plain language
  lawyers LawyerProfile[] @relation("LawyerCats")
}

model LawyerProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id])
  bio         String
  city        String
  court       String // e.g. "Delhi High Court"
  years       Int
  tier        Tier
  fee         Int // 399 | 549 | 799
  bciNumber   String
  status      Status   @default(PENDING)
  rating      Float    @default(4.6)
  reviewCount Int      @default(0)
  online      Boolean  @default(false)
  languages   String[]

  // Paid placement (LAUNCH.md Task 5)
  promoted      Boolean   @default(false)
  promotedRank  Int? // 1 = top; null if not promoted
  promotedUntil DateTime? // campaign end; past = treated as not promoted
  promotedTier  PromoTier @default(NONE)

  categories Category[] @relation("LawyerCats")
  slots      Slot[]
  bookings   Booking[]
}

model Slot {
  id       String        @id @default(cuid())
  lawyerId String
  lawyer   LawyerProfile @relation(fields: [lawyerId], references: [id])
  startsAt DateTime
  booked   Boolean       @default(false)

  @@index([lawyerId, startsAt])
}

model Booking {
  id          String        @id @default(cuid())
  clientId    String
  client      User          @relation(fields: [clientId], references: [id])
  lawyerId    String
  lawyer      LawyerProfile @relation(fields: [lawyerId], references: [id])
  slotAt      DateTime
  amount      Int
  lawyerCut   Int
  platformCut Int
  paid        Boolean       @default(false)
  createdAt   DateTime      @default(now())

  // Rewards. The discount comes out of the platform's share of the economics
  // — amount / lawyerCut / platformCut stay whatever the fee card promised.
  discount     Int @default(0) // rupees knocked off what the client pays
  pointsEarned Int @default(0)
  pointsSpent  Int @default(0)

  // Either side can close the consultation; the thread then goes read-only.
  endedAt DateTime?
  endedBy Role?

  messages Message[]

  @@index([clientId, slotAt])
  @@index([lawyerId, slotAt])
}

model Message {
  id         String   @id @default(cuid())
  bookingId  String
  booking    Booking  @relation(fields: [bookingId], references: [id])
  senderRole Role // ADMIN = system line (e.g. "consultation ended")
  body       String
  createdAt  DateTime @default(now())

  // The chat poll reads this every 2s — by far the hottest query we run.
  @@index([bookingId, createdAt])
}

/**
 * The suggestion box. Deliberately not related to User: a suggestion has to
 * work when it comes from a signed-out visitor, and a submission is a record
 * of what someone said at the time — it should not change or disappear
 * because the account behind it did. The sender's details are copied in.
 */
model Feedback {
  id        String       @id @default(cuid())
  kind      FeedbackKind @default(SUGGESTION)
  body      String
  name      String? // blank when sent anonymously
  email     String? // optional, only so we can reply
  role      Role? // who was signed in, if anyone
  userId    String? // no FK on purpose — see above
  page      String? // the route it was sent from
  handled   Boolean      @default(false)
  createdAt DateTime     @default(now())

  @@index([createdAt])
}

model RewardLedger {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id])
  kind      RewardKind
  points    Int // positive on EARN, negative on REDEEM
  reason    String
  bookingId String?
  createdAt DateTime   @default(now())

  @@index([userId, createdAt])
}
